# 复制为 .env 后按需修改；npm start 会自动加载（tsx --env-file-if-exists=.env）
# 优先级：命令行显式传入的环境变量 > .env 里的值

# 代理：fapi.binance.com 在部分网络被墙，走本地代理（Clash/mihomo 默认 7890）
# 不需要代理时，把这行注释掉即可直连。
# Docker 部署时镜像内置 mihomo：不设置 PROXY 时，entrypoint 会自动把它指向容器内的
# http://127.0.0.1:7890，无需在宿主机另开代理（详见下方「容器内 mihomo」一节）。
PROXY=http://127.0.0.1:7890

# —— 容器内 mihomo（Docker 部署，仅 docker-compose/Dockerfile 生效）——
# 镜像已内置 mihomo 内核；容器启动时先在容器内拉起 mihomo，再把 PROXY 指向它，
# 因此 Binance 行情监控与 Telegram 播报都会经由容器内 mihomo 出站。
# 提供代理节点的两种方式（二选一）：
#   1) 在 .env 里填 Clash/Mihomo YAML 订阅地址（docker-compose 默认已内置下面两个公共订阅源）：
#      MIHOMO_SUBSCRIPTION_URL=https://raw.githubusercontent.com/wzmwayne/proxy-node/main/output/aio/clash.yaml,https://raw.githubusercontent.com/ovmvo/FreeSub/refs/heads/main/sub/permanent/mihomo.yaml
#      支持多个订阅源（逗号 / 空格 / 换行分隔），每个都作为 mihomo proxy-provider 加载。
#   2) 挂载你自己的完整配置（见 docker-compose.yml 中被注释的 volumes）：
#      ./docker/mihomo/config.yaml:/etc/mihomo/config.yaml:ro
# 默认 provider 模式会把订阅当 proxy-provider，并用 PROXY(fallback) 组对 Binance 做
# 健康检查（expected-status=200），只挑选 Binance 不屏蔽的节点，自动规避 HTTP 451；
# 若你的订阅本身已配好规则并想完全沿用，可设 MIHOMO_CONFIG_MODE=raw（订阅直接当配置）。
# 都不提供时使用内置默认配置（全部直连，不会中断监控，但等于没走代理）。
# MIHOMO_ENABLE=1              # 置 0 关闭容器内 mihomo
# MIHOMO_CONFIG_MODE=provider # provider（默认）/ raw
# MIHOMO_HEALTHCHECK_URL=https://fapi.binance.com/fapi/v1/ping  # 选点用的健康检查地址
# MIHOMO_HEALTHCHECK_INTERVAL=600  # 健康检查周期（秒）
# MIHOMO_PROXY_PORT=7890       # 容器内 mihomo 混合端口
# MIHOMO_SUBSCRIPTION_PROXY=http://host.docker.internal:7890  # 拉订阅本身也需要代理时（仅 raw 模式下载订阅时使用）
# 注意：显式设置了 PROXY/HTTPS_PROXY/HTTP_PROXY 时，entrypoint 会沿用你的设置，不再自动指向容器内 mihomo。

# 其余可选项（不设则用默认值）
# PORT=4111
# TOP_N=10
# REFRESH_TTL_MS=60000  # 默认 60s（60000ms），对齐 1m K 线收盘周期并防止 API 超频
# KLINE_LIMIT=100
# KLINE_INIT_LIMIT=500  # 标的初次初始化拉取的 1m K 线数量（500 根用于直接在本地合成 100 根 5m K 线）
# HIGH_RATIO=0.8
# HIGH_WINDOW=100
# PROACTIVE_BACKOFF_WEIGHT=1800  # 主动避让防429阈值（Binance每分钟限额2400权重，达标即主动进入冷静期）
# BINANCE_BASE=https://fapi.binance.com
# FALLBACK_BASE=

# —— Telegram 告警 ——
# 当三个榜单（24h涨幅榜/跌幅榜/成交额榜）任意一个出现 ≥ TG_ALERT_MIN (默认 3) 个「无支撑 + 1m DIFF>0 + 5m DIFF<0」时推送。
# 首次命中时通知，持续命中期间不因数量变化而重复播报，避免频繁轰炸。
# Bot Token 从 @BotFather 获取；chat_id 可先给 @userinfobot 发消息查询，
# 或先向你的 bot 发一条消息后用 getUpdates 接口拿。代理沿用上面的 PROXY/HTTP(S)_PROXY。
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE=https://api.telegram.org
# TG_ALERT_MIN=3
# TG_REPEAT_MINUTES=0        # >0 则在持续命中时按该固定间隔重发提醒（分钟，0 为仅在首次触发时通知）
# DASHBOARD_URL=https://macd.reluv.xyz  # 告警消息中附带的面板直达链接

# —— 模拟实盘交易 (Paper Trading) ——
# 基于全市场 119,655 根 1m K 线量化挖掘出的最优低杠杆大止损长持仓配置
# PAPER_LEVERAGE=3           # 杠杆倍数 (推荐 3x，黄金收益/回撤比，零爆仓风险)
# PAPER_MARGIN_USDT=20       # 单笔保证金 (20 USDT, 3x 杠杆名义仓位 60 USDT)
# PAPER_INITIAL_BALANCE=100  # 初始模拟资金 (100 USDT)
# PAPER_STOP_AT_HIGH=true    # 开启极端最高点止损模式 (按 1m 尖刺最高价撮合)

# —— Docker & Traefik 部署 ——
DOMAIN=macd.yourdomain.com
# TRAEFIK_NETWORK=traefik   # Traefik 外部网络名称，默认 traefik
