{
  "name": "binance-macd-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitor 1m MACD high-position death cross on Binance 24h top gainers / losers / volume",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "concurrently -k -n server,web -c green,cyan \"tsx watch --env-file-if-exists=.env src/server.ts\" \"npm --prefix web run dev\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "tsx --test research/tests/*.test.ts && tsx scripts/test-alert.ts && tsx scripts/test-ws-candles.ts",
    "research": "tsx --env-file-if-exists=.env research/cli.ts",
    "research:wick": "tsx --env-file-if-exists=.env research/cli.ts wick",
    "mine": "tsx --env-file-if-exists=.env research/miner.ts",
    "mine:btc5m": "tsx --env-file-if-exists=.env research/miner.ts --study btc5m",
    "mine:monitor": "tsx --env-file-if-exists=.env research/monitor-miner.ts",
    "mine:setup": "uv venv --python 3.12 .venv-gpu && uv pip install --python .venv-gpu/bin/python -r research/gpu/requirements.txt",
    "test:gpu": "GPU_REQUIRED=1 tsx --test research/tests/gpu.test.ts"
  },
  "dependencies": {
    "@esbuild/linux-arm64": "^0.28.2",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
